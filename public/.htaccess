# Apache configuration (shared hosting). The document root must be this public/ directory.
Options -Indexes -MultiViews
DirectoryIndex index.php

# Never serve dotfiles (.user.ini, .htaccess…).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# HTTPS is forced by the hosting panel (TLS often ends at the host's proxy, where a redirect
# written here could loop or be skipped with a forged X-Forwarded-Proto). See docs/deploy/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pass the Authorization header and route everything else to the front controller.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Without mod_rewrite the application cannot work: refuse instead of exposing anything.
    Require all denied
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    # Static files (build/) get the same base protections as the pages served by PHP.
    <FilesMatch "\.(js|css)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Cross-Origin-Resource-Policy "same-origin"
    </FilesMatch>
</IfModule>
