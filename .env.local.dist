# Copy to .env.local (ignored by git) and fill in local values.
# Generate a secret with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'

# Required in every environment except test and e2e (no secret is committed for dev).
APP_SECRET=

# From phase 1 (database):
# DATABASE_URL="mysql://app:CHANGE_ME@127.0.0.1:3306/password_manager?serverVersion=8.0.32&charset=utf8mb4"

# Production only: secret code asked when creating the account (php -r 'echo bin2hex(random_bytes(12));').
# REGISTRATION_CODE=
