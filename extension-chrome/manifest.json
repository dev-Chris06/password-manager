{
  "manifest_version": 3,
  "name": "Gestionnaire MDP - Remplissage automatique",
  "version": "1.0.4",
  "description": "Remplit les identifiants depuis le gestionnaire de mots de passe local PHP.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Activer le remplissage sur cet onglet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": []
}
