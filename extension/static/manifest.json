{
  "manifest_version": 3,
  "name": "Gestionnaire de mots de passe",
  "description": "Remplit vos identifiants depuis votre coffre zero-knowledge. Le déchiffrement a lieu dans l'extension.",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Gestionnaire de mots de passe", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
