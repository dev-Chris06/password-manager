# Caddy: automatic HTTPS (Let's Encrypt) in front of PHP-FPM.
# Replace coffre.example.fr by your domain (its DNS must point to this server).
coffre.example.fr {
	root * /srv/password-manager/current/public
	encode zstd gzip

	# Built assets are served directly.
	@static path /build/*
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Cross-Origin-Resource-Policy same-origin
		file_server
	}

	# Everything else goes to public/index.php: no other PHP file can ever be executed.
	handle {
		rewrite * /index.php
		php_fastcgi unix//run/php/password-manager.sock
	}

	header -Server
	log {
		output file /var/log/caddy/password-manager.log
	}
}
